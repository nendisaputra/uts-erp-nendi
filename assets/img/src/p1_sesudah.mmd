flowchart TB
  subgraph UI["Modul ERP (satu antarmuka)"]
    PJ["Penjualan<br/>Sales Order"]
    GD["Gudang<br/>Stok & Goods Receipt"]
    PR["Produksi<br/>BOM & Work Order"]
    KU["Keuangan<br/>Jurnal & Piutang/Utang"]
  end
  DB[("DATABASE ERP TERPUSAT<br/>Data master bersama: Pelanggan · Barang · BOM · Gudang · Pemasok · Akun (CoA)")]
